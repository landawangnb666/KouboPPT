# 统一换行符策略：仓库内以 LF 存储，检出到 Windows 时按需转换
* text=auto

# 源码与文档：统一 LF
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

# Windows 专用脚本：保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.iss   text eol=crlf

# 二进制：不做任何转换
*.exe   binary
*.dll   binary
*.pyd   binary
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ttf   binary
*.otf   binary
*.pptx  binary
*.docx  binary
*.pdf   binary
*.mp4   binary

